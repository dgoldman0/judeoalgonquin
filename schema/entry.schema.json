{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/judeoalgonquin/entry.schema.json",
  "title": "Judeo-Algonquin language record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_type",
    "revision",
    "status",
    "level",
    "forms",
    "senses",
    "grammatical_features",
    "notes",
    "formation",
    "source_evidence",
    "provenance",
    "relations",
    "composition",
    "construction_spec",
    "paradigm",
    "metadata",
    "created_at",
    "updated_at",
    "change_note"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/recordId"},
    "record_type": {
      "enum": ["lexeme", "morpheme", "phrase", "sentence", "paragraph", "construction"]
    },
    "revision": {"type": "integer", "minimum": 1},
    "status": {
      "enum": [
        "draft",
        "candidate",
        "reviewed",
        "canonical",
        "deprecated",
        "superseded",
        "rejected"
      ]
    },
    "level": {"enum": ["unassigned", "N1", "N2", "D1", "D2", "R1"]},
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["english", "judeo_algonquin"],
      "properties": {
        "english": {"$ref": "#/$defs/nonemptyStringArray"},
        "judeo_algonquin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hebrew_script", "romanization", "orthography"],
          "properties": {
            "hebrew_script": {"type": "string", "minLength": 1},
            "unpointed": {"type": "string"},
            "romanization": {"type": "string", "minLength": 1},
            "segmentation": {"type": "string"},
            "morpheme_gloss": {"type": "string"},
            "variants": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
            "orthography": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "profile_id",
                "script_origin",
                "input_system",
                "input_level",
                "source_exact",
                "normalized_input",
                "reversibility"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "source_retained",
                    "provisional_transport",
                    "contact_adapted",
                    "componentwise",
                    "project_schematic",
                    "unverified"
                  ]
                },
                "profile_id": {"type": "string", "minLength": 1},
                "script_origin": {
                  "enum": [
                    "retained_hebrew",
                    "munsee_source_transport",
                    "contact_adapted",
                    "componentwise",
                    "project_schematic",
                    "legacy_unverified"
                  ]
                },
                "input_system": {"type": "string", "minLength": 1},
                "input_level": {
                  "enum": [
                    "source_hebrew",
                    "citation",
                    "surface",
                    "morphophonemic",
                    "contact_phonemic",
                    "componentwise",
                    "schematic",
                    "unverified"
                  ]
                },
                "source_exact": {"type": "string"},
                "normalized_input": {"type": "string", "minLength": 1},
                "reversibility": {
                  "enum": ["not_transduced", "pointed_only", "componentwise", "unverified"]
                }
              },
              "allOf": [
                {
                  "if": {"properties": {"status": {"const": "source_retained"}}},
                  "then": {"properties": {
                    "profile_id": {"const": "hebrew_source_retained"},
                    "script_origin": {"const": "retained_hebrew"},
                    "input_level": {"const": "source_hebrew"},
                    "reversibility": {"const": "not_transduced"}
                  }}
                },
                {
                  "if": {"properties": {"status": {"const": "provisional_transport"}}},
                  "then": {"properties": {
                    "profile_id": {"const": "omeara_hebrew_transport"},
                    "script_origin": {"const": "munsee_source_transport"},
                    "input_level": {"enum": ["citation", "surface", "morphophonemic"]},
                    "source_exact": {"type": "string", "minLength": 1},
                    "reversibility": {"const": "pointed_only"}
                  }}
                },
                {
                  "if": {"properties": {"status": {"const": "contact_adapted"}}},
                  "then": {"properties": {
                    "profile_id": {"const": "contact_pointed_candidate"},
                    "script_origin": {"const": "contact_adapted"},
                    "input_level": {"const": "contact_phonemic"},
                    "reversibility": {"const": "pointed_only"}
                  }}
                },
                {
                  "if": {"properties": {"status": {"const": "componentwise"}}},
                  "then": {"properties": {
                    "profile_id": {"const": "componentwise_analytic"},
                    "script_origin": {"const": "componentwise"},
                    "input_level": {"const": "componentwise"},
                    "reversibility": {"const": "componentwise"}
                  }}
                },
                {
                  "if": {"properties": {"status": {"const": "project_schematic"}}},
                  "then": {"properties": {
                    "profile_id": {"const": "project_schematic"},
                    "script_origin": {"const": "project_schematic"},
                    "input_level": {"const": "schematic"},
                    "reversibility": {"const": "not_transduced"}
                  }}
                },
                {
                  "if": {"properties": {"status": {"const": "unverified"}}},
                  "then": {"properties": {
                    "profile_id": {"const": "legacy_unverified"},
                    "script_origin": {"const": "legacy_unverified"},
                    "input_level": {"const": "unverified"},
                    "reversibility": {"const": "unverified"}
                  }}
                }
              ]
            }
          }
        }
      }
    },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "glosses", "definition", "part_of_speech", "translations"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ja\\.(lexeme|morpheme|phrase|sentence|paragraph|construction)\\.[a-z0-9][a-z0-9_-]*\\.sense\\.[a-z0-9][a-z0-9_-]*$"
          },
          "glosses": {"$ref": "#/$defs/nonemptyStringArray"},
          "definition": {"type": "string", "minLength": 1},
          "part_of_speech": {"type": "string", "minLength": 1},
          "translations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["literal", "idiomatic"],
            "properties": {
              "literal": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
              "idiomatic": {"$ref": "#/$defs/nonemptyStringArray"}
            }
          }
        }
      }
    },
    "grammatical_features": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "grammar", "design"],
      "properties": {
        "translation": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "grammar": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "design": {"$ref": "#/$defs/nonemptyStringArrayOptional"}
      }
    },
    "formation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_etymology",
        "formation_kind",
        "inputs",
        "operations",
        "formation_process",
        "design_alignment"
      ],
      "properties": {
        "historical_etymology": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "source_ids", "locator", "confidence"],
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "source_ids": {"$ref": "#/$defs/nonemptyStringArray"},
              "locator": {"type": "string", "minLength": 1},
              "confidence": {"enum": ["low", "medium", "high"]}
            }
          }
        },
        "formation_kind": {
          "enum": [
            "direct_borrowing",
            "phonological_adaptation",
            "orthographic_adaptation",
            "calque",
            "blend",
            "compound",
            "derivation",
            "semantic_reallocation",
            "semantic_extension",
            "new_coinage",
            "mixed"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_type", "input_id", "form", "contribution"],
            "properties": {
              "input_type": {"enum": ["source_record", "language_record", "project_design"]},
              "input_id": {"type": "string", "minLength": 1},
              "form": {"type": "string"},
              "contribution": {"type": "string", "minLength": 1}
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "operation", "description"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "operation": {
                "enum": [
                  "retain",
                  "transliterate",
                  "phonological_adaptation",
                  "orthographic_adaptation",
                  "combine",
                  "derive",
                  "calque",
                  "semantic_reallocation",
                  "semantic_extension",
                  "regularize",
                  "other"
                ]
              },
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "formation_process": {"type": "string"},
        "design_alignment": {"type": "string"}
      }
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "language",
          "lect",
          "source_form",
          "source_meaning",
          "grammatical_information",
          "locator",
          "contributor_or_speaker",
          "license_status",
          "accessed_at",
          "confidence",
          "uncertainty",
          "supports_sense_ids",
          "use_type",
          "gap_reason"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "lect": {"type": "string"},
          "source_form": {"type": "string", "minLength": 1},
          "source_meaning": {"type": "string", "minLength": 1},
          "grammatical_information": {"type": "string"},
          "locator": {"type": "string", "minLength": 1},
          "contributor_or_speaker": {"type": "string"},
          "license_status": {"type": "string", "minLength": 1},
          "accessed_at": {"type": "string", "format": "date"},
          "confidence": {"enum": ["low", "medium", "high", "unknown"]},
          "uncertainty": {"type": "string"},
          "supports_sense_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ja\\.(lexeme|morpheme|phrase|sentence|paragraph|construction)\\.[a-z0-9][a-z0-9_-]*\\.sense\\.[a-z0-9][a-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "use_type": {
            "enum": ["lexical", "grammatical", "historical", "orthographic", "cultural_context", "comparative"]
          },
          "gap_reason": {"type": ["string", "null"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator_type", "source_ids"],
      "properties": {
        "creator_type": {"enum": ["human", "model", "legacy_import", "mixed"]},
        "source_ids": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "generation_note": {"type": "string"}
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends_on",
        "related_to",
        "conflicts_with",
        "supersedes",
        "superseded_by",
        "dependency_revisions"
      ],
      "properties": {
        "depends_on": {"$ref": "#/$defs/idArray"},
        "related_to": {"$ref": "#/$defs/idArray"},
        "conflicts_with": {"$ref": "#/$defs/idArray"},
        "supersedes": {"$ref": "#/$defs/idArray"},
        "superseded_by": {"$ref": "#/$defs/idArray"},
        "dependency_revisions": {
          "type": "object",
          "patternProperties": {
            "^ja\\.(lexeme|morpheme|phrase|sentence|paragraph|construction)\\.[a-z0-9][a-z0-9_-]*$": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "composition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["components", "construction_ids"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "record_id",
              "record_revision",
              "sense_id",
              "role",
              "realization"
            ],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "record_id": {"$ref": "#/$defs/recordId"},
              "record_revision": {"type": "integer", "minimum": 1},
              "sense_id": {
                "type": "string",
                "pattern": "^ja\\.(lexeme|morpheme|phrase|sentence|paragraph|construction)\\.[a-z0-9][a-z0-9_-]*\\.sense\\.[a-z0-9][a-z0-9_-]*$"
              },
              "role": {"type": "string", "minLength": 1},
              "realization": {"type": "string", "minLength": 1}
            }
          }
        },
        "construction_ids": {"$ref": "#/$defs/idArray"}
      }
    },
    "construction_spec": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "kind",
        "function",
        "formalism",
        "host_classes",
        "ordering",
        "allomorphy",
        "restrictions",
        "counterexamples",
        "test_refs",
        "productivity"
      ],
      "properties": {
        "kind": {"enum": ["morphological", "syntactic", "discourse", "orthographic"]},
        "function": {"type": "string", "minLength": 1},
        "formalism": {"type": "string", "minLength": 1},
        "host_classes": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "ordering": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "allomorphy": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "restrictions": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "counterexamples": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "test_refs": {"$ref": "#/$defs/nonemptyStringArray"},
        "productivity": {"enum": ["unproductive", "limited", "productive_candidate", "productive"]}
      }
    },
    "paradigm": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["dimensions", "cells", "gaps"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "values"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "values": {"$ref": "#/$defs/nonemptyStringArray"}
            }
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["features", "hebrew_script", "romanization", "segmentation", "morpheme_gloss", "meaning", "status"],
            "properties": {
              "features": {"$ref": "#/$defs/featureMap"},
              "hebrew_script": {"type": "string", "minLength": 1},
              "romanization": {"type": "string", "minLength": 1},
              "segmentation": {"type": "string"},
              "morpheme_gloss": {"type": "string"},
              "meaning": {"type": "string", "minLength": 1},
              "status": {"enum": ["attested_source", "adapted_candidate", "reviewed", "canonical"]}
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["features", "reason"],
            "properties": {
              "features": {"$ref": "#/$defs/featureMap"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registers", "domains", "tags", "creative_anchor"],
      "properties": {
        "registers": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "domains": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "tags": {"$ref": "#/$defs/nonemptyStringArrayOptional"},
        "creative_anchor": {"type": ["string", "null"]},
        "lexical_layer": {
          "enum": [
            "donor_candidate",
            "direct_contact_inheritance",
            "contact_native_formation",
            "learned_literary_reborrowing"
          ]
        }
      }
    },
    "narrative_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clauses", "transition"],
      "properties": {
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clause_id",
              "construction_ids",
              "event_role",
              "participants",
              "center_shift"
            ],
            "properties": {
              "clause_id": {"type": "string", "minLength": 1},
              "construction_ids": {"$ref": "#/$defs/idArray"},
              "event_role": {
                "enum": [
                  "foreground",
                  "background",
                  "consequence",
                  "habitual",
                  "standing_pattern",
                  "dialogue",
                  "other"
                ]
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["participant_id", "discourse_status"],
                  "properties": {
                    "participant_id": {"type": "string", "minLength": 1},
                    "discourse_status": {
                      "enum": ["proximate", "obviative", "overt", "unspecified"]
                    }
                  }
                }
              },
              "center_shift": {"type": "boolean"}
            }
          }
        },
        "transition": {"type": ["string", "null"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_type", "reviewer_id", "authority", "decision", "reviewed_at", "note"],
      "properties": {
        "reviewer_type": {"const": "human"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "decision": {
          "enum": ["reviewed", "canonical", "deprecated", "superseded", "rejected"]
        },
        "reviewed_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "change_note": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["reviewed", "canonical", "deprecated", "superseded", "rejected"]}
        },
        "required": ["status"]
      },
      "then": {"required": ["review"]},
      "else": {"not": {"required": ["review"]}}
    },
    {
      "if": {
        "properties": {"record_type": {"enum": ["phrase", "sentence", "paragraph"]}},
        "required": ["record_type"]
      },
      "then": {
        "properties": {
          "composition": {"type": "object"},
          "senses": {
            "items": {
              "properties": {
                "translations": {
                  "properties": {
                    "literal": {"$ref": "#/$defs/nonemptyStringArray"}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"record_type": {"const": "construction"}},
        "required": ["record_type"]
      },
      "then": {"properties": {"construction_spec": {"type": "object"}}}
    },
    {
      "if": {
        "properties": {
          "record_type": {"enum": ["lexeme", "morpheme"]},
          "forms": {
            "properties": {
              "judeo_algonquin": {
                "properties": {
                  "orthography": {
                    "properties": {"status": {"const": "contact_adapted"}},
                    "required": ["status"]
                  }
                },
                "required": ["orthography"]
              }
            },
            "required": ["judeo_algonquin"]
          }
        },
        "required": ["record_type", "forms"]
      },
      "then": {
        "properties": {
          "metadata": {
            "required": ["lexical_layer"],
            "properties": {
              "lexical_layer": {
                "enum": [
                  "direct_contact_inheritance",
                  "contact_native_formation",
                  "learned_literary_reborrowing"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^ja\\.(lexeme|morpheme|phrase|sentence|paragraph|construction)\\.[a-z0-9][a-z0-9_-]*$"
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonemptyStringArrayOptional": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "idArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/recordId"},
      "uniqueItems": true
    },
    "featureMap": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "minProperties": 1
    }
  }
}
